package com.klu.bank.service;

import org.springframework.stereotype.Service;
import com.klu.bank.repository.BankRepository;

@Service
public class BankService {

    private final BankRepository repo;

    public BankService(BankRepository repo) {
        this.repo = repo;
    }

    // Method 1: Normal login
    public String login(String username, String password) {
        return checkAndLogin(username, password);
    }

    // Method 2: Check credentials and login
    public String checkAndLogin(String username, String password) {

        boolean result =
                repo.existsByUsernameAndPassword(username, password);

        if (result) {
            return "Login Successful";
        } else {
            return "Invalid Username or Password";
        }
    }
}